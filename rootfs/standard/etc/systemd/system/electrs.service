# MyNode electrs service
# /etc/systemd/system/electrs.service

[Unit]
Description=MyNode Electrum Server
Wants=bitcoin.service
After=bitcoin.service

[Service]
Type=simple
KillMode=process
ExecStartPre=/usr/bin/is_not_shutting_down.sh
ExecStartPre=/usr/bin/wait_on_bitcoin.sh
ExecStartPre=+/usr/bin/service_scripts/pre_electrs.sh
ExecStart=/usr/bin/electrs --conf=/mnt/hdd/mynode/electrs/electrs.toml
User=bitcoin
Group=bitcoin
# electrs v0.12+ builds its index with RocksDB compaction off and turns it on at the tip, when
# compaction opens the ~1000 level-0 files at once. The default limit of 1024 made it exit with
# "Too many open files" until the backlog cleared.
LimitNOFILE=65536
TimeoutSec=300
Restart=always
RestartSec=60
Nice=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=electrs

[Install]
WantedBy=multi-user.target
