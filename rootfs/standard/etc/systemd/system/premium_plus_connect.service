# MyNode Premium+ Connect
# /etc/systemd/system/premium_plus_connect.service

[Unit]
Description=MyNode Premium+ Connect
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/mynode-python /usr/bin/mynode_premium_plus_connect.py
User=root
Group=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=premium_plus_connect
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
