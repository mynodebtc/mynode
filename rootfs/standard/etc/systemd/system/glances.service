# MyNode glances service (system monitoring)
# /etc/systemd/system/glances.service

[Unit]
Description=Glances
After=network.target
# Only on 64-bit, where Glances has its own venv
ConditionPathExists=/usr/local/lib/mynode/venv/glances/bin/glances

[Service]
ExecStart=/usr/local/lib/mynode/venv/glances/bin/glances -w
User=root
Group=root
TimeoutSec=120
Restart=always
RestartSec=60
Nice=5

[Install]
WantedBy=multi-user.target