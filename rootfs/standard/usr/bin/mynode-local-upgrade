#!/bin/bash

# mynode-local-upgrade
# This script needs to be run with sudo
# It requests an IP, downloads the latest rootfs, installs it, and reboots the device
# The first argument may instead be the path to a local rootfs tarball, in which
# case nothing is downloaded and that file is installed directly.
#
# Usage: mynode-local-upgrade [IP_ADDRESS|ROOTFS_TAR_GZ] [SERVICE] [PORT]

set -e

source /usr/share/mynode/mynode_config.sh

tarball="/tmp/mynode_rootfs_${DEVICE_TYPE}.tar.gz"
local_file=""

# Prompt for IP (or use a local rootfs tarball if given one)
ip_address="error"
if [ "$#" -lt 1 ]; then
    echo "Make sure your PC is running 'make start_file_server'..."
    echo -n "Dev PC IP Address: "
    read ip_address
elif [ -f "$1" ]; then
    local_file="$1"
else
    echo "Make sure your PC is running 'make start_file_server'..."
    ip_address="$1"
fi

# Optional file server port (3rd arg or env var, default 8000)
port="${3:-${MYNODE_FILE_SERVER_PORT:-8000}}"

# Clear /var/log tmpfs (remake necessary folders)
rm -rf /var/log/*
mkdir -p /var/log/nginx

if [ -n "$local_file" ]; then
    # Use the provided local rootfs tarball
    echo "Installing rootfs from ${local_file}..."
    tarball="$local_file"
else
    # Delete any existing rootfs tarball and download new one
    rm -f mynode_rootfs_${DEVICE_TYPE}.tar.gz
    rm -f "${tarball}"
    wget http://${ip_address}:${port}/mynode_rootfs_${DEVICE_TYPE}.tar.gz -O "${tarball}" --progress=bar
fi

# Extract to temp location
echo -n "Extracting rootfs TAR for ${DEVICE_TYPE}... "
start_time=$(date +%s)
rm -rf /tmp/rootfs/
mkdir -p /tmp/rootfs/
tar --warning=no-unknown-keyword -xf "${tarball}" -C /tmp/rootfs/
end_time=$(date +%s)
diff_time=$((end_time - start_time))
echo "Done in ${diff_time}s!"

# Make sure the tarball actually contains a rootfs for this device
if [ ! -d "/tmp/rootfs/out/rootfs_${DEVICE_TYPE}" ]; then
    echo "ERROR: Tarball does not contain a rootfs for this device (${DEVICE_TYPE})!"
    found=$(ls -1d /tmp/rootfs/out/rootfs_* 2>/dev/null | sed 's|.*/rootfs_||' | tr '\n' ' ')
    if [ -n "${found}" ]; then
        echo "       Tarball contains: ${found}"
    else
        echo "       Tarball does not look like a MyNode rootfs build."
    fi
    rm -rf /tmp/rootfs/
    exit 1
fi

# Clear files before installing/overwriting new ones
echo -n "Clearing old rootfs files... "
start_time=$(date +%s)
rm -rf /var/www/mynode/static/images/screenshots
for d in /usr/share/mynode_apps/*/screenshots ; do
    rm -rf "$d"
done
end_time=$(date +%s)
diff_time=$((end_time - start_time))
echo "Done in ${diff_time}s!"

# Install files
echo -n "Copying new rootfs... "
start_time=$(date +%s)
rsync -r -K /tmp/rootfs/out/rootfs_${DEVICE_TYPE}/* /
end_time=$(date +%s)
diff_time=$((end_time - start_time))
echo "Done in ${diff_time}s!"

# Sleep and sync FS
echo -n "Syncing filesystem... "
start_time=$(date +%s)
sleep 1
sync /
end_time=$(date +%s)
diff_time=$((end_time - start_time))
echo "Done in ${diff_time}s!"

# Reload systemd files
systemctl daemon-reload

echo ""

# Restart or reboot
if [ "$#" -ge 2 ]; then
    # Restart service
    if   [ "$2" = "apps" ]; then
        mynode-manage-apps init || true
    elif [ "$2" = "www" ]; then
        mynode-manage-apps init || true
        echo "Restarting www service..."
        systemctl restart www
    elif [ "$2" = "mempool" ]; then
        echo "Restarting mempool service..."
        systemctl restart mempool &
    elif [ "$2" = "docker_images" ]; then
        echo "Restarting docker_images..."
        systemctl restart docker_images &
    elif [ "$2" = "files" ]; then
        echo "Only updating files... Done."
    elif [ "$2" = "nginx" ]; then
        echo "Restarting nginx service..."
    elif [ "$2" = "reboot" ]; then
        echo "Rebooting..."
    else
        # Service not found, reboot
        echo "Unknown service, rebooting"
        /usr/bin/mynode_stop_critical_services.sh
        reboot
    fi
else
    # Init Dynamic Apps
    mynode-manage-apps init || true

    # Default, full upgrade
    echo "Full upgrade, running post upgrade script and rebooting device..."
    /bin/bash /usr/bin/mynode_post_upgrade.sh
    if [ $? -ne 0 ]; then
        echo "ERROR: Post upgrade script failed!"
        exit 1
    fi
    reboot
fi
